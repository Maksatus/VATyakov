.vat-root {
    padding-top: 4px;
}

/* --- cards ------------------------------------------------------------------------------- */

.vat-card {
    margin-top: 6px;
    padding: 6px 8px 8px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.25);
    background-color: rgba(0, 0, 0, 0.08);
}

.vat-card__title {
    -unity-font-style: bold;
    margin: 0 0 4px 3px;
    opacity: 0.8;
}

.vat-hint {
    white-space: normal;
    font-size: 11px;
    opacity: 0.7;
    margin: 2px 3px 4px 3px;
}

.vat-hint--error {
    color: rgb(230, 90, 80);
    opacity: 1;
}

.vat-problems {
    margin: 6px 0 0 0;
}

/* --- buttons ----------------------------------------------------------------------------- */

.vat-primary-button {
    height: 30px;
    margin: 8px 0 0 0;
    border-radius: 4px;
    border-width: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(46, 110, 180);
}

.vat-primary-button:hover {
    background-color: rgb(60, 128, 200);
}

.vat-primary-button:active {
    background-color: rgb(36, 92, 154);
}

.vat-primary-button:disabled {
    background-color: rgba(46, 110, 180, 0.35);
    color: rgba(255, 255, 255, 0.6);
}

.vat-secondary-button {
    height: 22px;
    margin: 4px 3px 0 3px;
}

/* --- stats ------------------------------------------------------------------------------- */

.vat-stats {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 2px;
}

.vat-stat {
    flex-grow: 1;
    flex-basis: 30%;
    min-width: 80px;
    margin: 2px;
    padding: 4px 6px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.12);
}

.vat-stat__value {
    font-size: 14px;
    -unity-font-style: bold;
}

.vat-stat__name {
    font-size: 10px;
    opacity: 0.65;
}

/* --- object links ------------------------------------------------------------------------ */

.vat-link {
    flex-direction: row;
    align-items: center;
    margin: 1px 3px;
    min-height: 20px;
}

.vat-link__label {
    width: 40%;
    min-width: 100px;
}

.vat-link__button {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    height: 20px;
    margin: 0;
    padding: 0 4px;
    -unity-text-align: middle-left;
}

.vat-link__icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    flex-shrink: 0;
}

.vat-link__name {
    overflow: hidden;
    text-overflow: ellipsis;
}

/* --- clip list --------------------------------------------------------------------------- */

.vat-clip {
    flex-direction: row;
    justify-content: space-between;
    margin: 2px 3px;
    padding: 4px 6px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.12);
}

.vat-clip__name {
    -unity-font-style: bold;
}

.vat-clip__info {
    opacity: 0.7;
}

.vat-foldout {
    margin-top: 8px;
}
